# Copy this file to .env and fill in your values
# Never commit .env to version control
# RETELL_AGENT_ID_* values are only needed for seed script

# -- Database ------------------------------------------
MONGO_URI=mongodb://localhost:27017
DB_NAME=recruitment_portal

# -- Auth ----------------------------------------------
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# -- Groq AI -------------------------------------------
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# -- Retell AI (Voice Interview) -----------------------
RETELL_API_KEY=key_your_retell_api_key_here
RETELL_WEBHOOK_SECRET=key_your_retell_webhook_secret_here
BACKEND_URL=http://localhost:8000

# -- Retell Agent IDs ----------------------------------
# Get these from your Retell dashboard after creating agents
# Run scripts/seed_interviewers.py after setting these
RETELL_AGENT_ID_LISA=agent_your_lisa_agent_id_here
RETELL_AGENT_ID_BOB=agent_your_bob_agent_id_here

# ── Vector Store & Embeddings ──────────────────────────────────────────────
# Sentence-transformer model used to generate JD embeddings.
# Change this only when upgrading the embedding model (requires re-embedding all jobs).
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ChromaDB in-memory collection name for JD vectors.
CHROMA_COLLECTION_NAME=job_jds

# ── Chatbot ────────────────────────────────────────────────────────────────
# No additional env vars required for the chatbot module.
# Chatbot uses the existing GROQ_API_KEY and MongoDB connection.
# Chatbot sessions are stored in the chatbot_sessions MongoDB collection.
