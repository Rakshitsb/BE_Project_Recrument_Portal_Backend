# Copy this file to .env and fill in your values
# Never commit .env to version control
# RETELL_AGENT_ID_* values are only needed for seed script

# -- Database ------------------------------------------
MONGO_URI=mongodb://localhost:27017
DB_NAME=recruitment_portal

# -- Auth ----------------------------------------------
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# -- Groq AI -------------------------------------------
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# -- Retell AI (Voice Interview) -----------------------
RETELL_API_KEY=key_your_retell_api_key_here
BASE_URL=http://localhost:8000

# -- Retell Agent IDs ----------------------------------
# Get these from your Retell dashboard after creating agents
# Run scripts/seed_interviewers.py after setting these
RETELL_AGENT_ID_LISA=agent_your_lisa_agent_id_here
RETELL_AGENT_ID_BOB=agent_your_bob_agent_id_here
